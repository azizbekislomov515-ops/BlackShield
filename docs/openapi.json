{
  "components": {
    "schemas": {
      "DeltaAddition": {
        "properties": {
          "algorithm": {
            "enum": [
              "md5",
              "sha1",
              "sha256"
            ],
            "title": "Algorithm",
            "type": "string"
          },
          "family": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Family"
          },
          "hash": {
            "title": "Hash",
            "type": "string"
          },
          "severity": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ],
            "title": "Severity",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "hash",
          "algorithm",
          "family",
          "severity",
          "version"
        ],
        "title": "DeltaAddition",
        "type": "object"
      },
      "DeltaRemoval": {
        "properties": {
          "algorithm": {
            "enum": [
              "md5",
              "sha1",
              "sha256"
            ],
            "title": "Algorithm",
            "type": "string"
          },
          "hash": {
            "title": "Hash",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "hash",
          "algorithm",
          "version"
        ],
        "title": "DeltaRemoval",
        "type": "object"
      },
      "DeltaResponse": {
        "properties": {
          "additions": {
            "description": "Upsert these signatures.",
            "items": {
              "$ref": "#/components/schemas/DeltaAddition"
            },
            "title": "Additions",
            "type": "array"
          },
          "latest_version": {
            "description": "Latest version at the time of this request.",
            "title": "Latest Version",
            "type": "integer"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Pass as `cursor` (with the same `since`) for the next page; null when done.",
            "title": "Next Cursor"
          },
          "removals": {
            "description": "Delete these signatures if present.",
            "items": {
              "$ref": "#/components/schemas/DeltaRemoval"
            },
            "title": "Removals",
            "type": "array"
          },
          "since": {
            "description": "The client's version, as requested.",
            "title": "Since",
            "type": "integer"
          },
          "until": {
            "description": "Version this delta brings the client to once every page is applied.",
            "title": "Until",
            "type": "integer"
          }
        },
        "required": [
          "since",
          "until",
          "latest_version",
          "additions",
          "removals",
          "next_cursor"
        ],
        "title": "DeltaResponse",
        "type": "object"
      },
      "DomainDeltaAddition": {
        "properties": {
          "category": {
            "enum": [
              "malware",
              "phishing"
            ],
            "title": "Category",
            "type": "string"
          },
          "domain": {
            "description": "Lower-case ASCII (IDNA) name; blocks it and every subdomain.",
            "title": "Domain",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "domain",
          "category",
          "version"
        ],
        "title": "DomainDeltaAddition",
        "type": "object"
      },
      "DomainDeltaRemoval": {
        "properties": {
          "domain": {
            "title": "Domain",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "domain",
          "version"
        ],
        "title": "DomainDeltaRemoval",
        "type": "object"
      },
      "DomainDeltaResponse": {
        "properties": {
          "additions": {
            "description": "Block these domains.",
            "items": {
              "$ref": "#/components/schemas/DomainDeltaAddition"
            },
            "title": "Additions",
            "type": "array"
          },
          "latest_version": {
            "description": "Latest version at the time of this request.",
            "title": "Latest Version",
            "type": "integer"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Pass as `cursor` (with the same `since`) for the next page; null when done.",
            "title": "Next Cursor"
          },
          "removals": {
            "description": "Stop blocking these domains.",
            "items": {
              "$ref": "#/components/schemas/DomainDeltaRemoval"
            },
            "title": "Removals",
            "type": "array"
          },
          "since": {
            "description": "The client's version, as requested.",
            "title": "Since",
            "type": "integer"
          },
          "until": {
            "description": "Version this delta brings the client to once fully applied.",
            "title": "Until",
            "type": "integer"
          }
        },
        "required": [
          "since",
          "until",
          "latest_version",
          "additions",
          "removals",
          "next_cursor"
        ],
        "title": "DomainDeltaResponse",
        "type": "object"
      },
      "DomainVersionResponse": {
        "properties": {
          "count": {
            "description": "Active domains in that version.",
            "title": "Count",
            "type": "integer"
          },
          "created_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "When that version was published.",
            "title": "Created At"
          },
          "version": {
            "description": "Latest published domain-list version; 0 if none.",
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "version",
          "created_at",
          "count"
        ],
        "title": "DomainVersionResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "LookupRequest": {
        "additionalProperties": false,
        "properties": {
          "hashes": {
            "description": "SHA-256 digests (hex). Never send file contents.",
            "items": {
              "pattern": "^[0-9a-fA-F]{64}$",
              "type": "string"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Hashes",
            "type": "array"
          }
        },
        "required": [
          "hashes"
        ],
        "title": "LookupRequest",
        "type": "object"
      },
      "LookupResponse": {
        "properties": {
          "results": {
            "description": "One entry per distinct hash, in request order.",
            "items": {
              "$ref": "#/components/schemas/Verdict"
            },
            "title": "Results",
            "type": "array"
          },
          "version": {
            "description": "Signature version the verdicts are based on.",
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "version",
          "results"
        ],
        "title": "LookupResponse",
        "type": "object"
      },
      "ReadinessResponse": {
        "properties": {
          "database": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Database",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "database"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "RulesetResponse": {
        "description": "A signed YARA ruleset (docs/sync-protocol.md#yara-rules).",
        "properties": {
          "key_id": {
            "description": "Which trusted public key verifies `signature`.",
            "title": "Key Id",
            "type": "string"
          },
          "published_at": {
            "format": "date-time",
            "title": "Published At",
            "type": "string"
          },
          "rules": {
            "description": "YARA rule source; may import only the `dex` and `math` modules.",
            "title": "Rules",
            "type": "string"
          },
          "sha256": {
            "description": "SHA-256 (lower-case hex) of `rules` encoded as UTF-8.",
            "title": "Sha256",
            "type": "string"
          },
          "signature": {
            "description": "Base64 DER ECDSA P-256/SHA-256 signature over `blackshield-yara-rules\n<version>\n<sha256>`.",
            "title": "Signature",
            "type": "string"
          },
          "version": {
            "description": "Increases with every published ruleset.",
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "version",
          "sha256",
          "key_id",
          "signature",
          "rules",
          "published_at"
        ],
        "title": "RulesetResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "Verdict": {
        "properties": {
          "family": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Family"
          },
          "hash": {
            "title": "Hash",
            "type": "string"
          },
          "severity": {
            "anyOf": [
              {
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "critical"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Severity"
          },
          "verdict": {
            "enum": [
              "malicious",
              "unknown"
            ],
            "title": "Verdict",
            "type": "string"
          }
        },
        "required": [
          "hash",
          "verdict"
        ],
        "title": "Verdict",
        "type": "object"
      },
      "VersionResponse": {
        "properties": {
          "count": {
            "description": "Active signatures in that version.",
            "title": "Count",
            "type": "integer"
          },
          "created_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "When that version was published.",
            "title": "Created At"
          },
          "version": {
            "description": "Latest published signature version; 0 if none.",
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "version",
          "created_at",
          "count"
        ],
        "title": "VersionResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "ApiKey": {
        "description": "BlackShield API key",
        "in": "header",
        "name": "X-API-Key",
        "type": "apiKey"
      },
      "Bearer": {
        "description": "The same API key as `Authorization: Bearer <key>`",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "\nMalware signature distribution for the BlackShield Android app.\n\n* **Sync:** poll `GET /v1/signatures/version`; new installs download `GET /v1/signatures/full`,\n  existing ones page through `GET /v1/signatures/delta`. See `docs/sync-protocol.md`.\n* **Reputation:** `POST /v1/reputation/lookup` with up to 100 SHA-256 digests. Hashes only.\n* **Auth:** every `/v1` request needs an API key in `X-API-Key` or `Authorization: Bearer`.\n",
    "title": "BlackShield API",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Liveness: the process is up and serving requests. Never touches the database.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "description": "Readiness: dependencies (PostgreSQL) are reachable.",
        "operationId": "readiness_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Readiness",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/domains/delta": {
      "get": {
        "description": "Net additions and removals since `since`, paginated, gzip-compressed.\n\nThe same protocol as `/v1/signatures/delta`: each domain appears at most once across all\npages with its latest state; store `until` only after the last page. `since=0` returns every\ndomain ever listed (removed ones as removals), which is how a client syncs the first time.",
        "operationId": "domains_delta_v1_domains_delta_get",
        "parameters": [
          {
            "description": "The client's current version; 0 for everything.",
            "in": "query",
            "name": "since",
            "required": true,
            "schema": {
              "description": "The client's current version; 0 for everything.",
              "minimum": 0,
              "title": "Since",
              "type": "integer"
            }
          },
          {
            "description": "Page size; defaults to 5,000 and is capped at 20,000.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Page size; defaults to 5,000 and is capped at 20,000.",
              "title": "Limit"
            }
          },
          {
            "description": "`next_cursor` from the previous page.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 1024,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "`next_cursor` from the previous page.",
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DomainDeltaResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "Invalid cursor, or cursor issued for a different `since`."
          },
          "409": {
            "description": "`since` is newer than the server's latest version; start from 0."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "ApiKey": []
          },
          {
            "Bearer": []
          }
        ],
        "summary": "Domains Delta",
        "tags": [
          "domains"
        ]
      }
    },
    "/v1/domains/version": {
      "get": {
        "description": "Latest published domain-list version. Clients poll this before syncing.",
        "operationId": "domains_version_v1_domains_version_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DomainVersionResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "ApiKey": []
          },
          {
            "Bearer": []
          }
        ],
        "summary": "Domains Version",
        "tags": [
          "domains"
        ]
      }
    },
    "/v1/reputation/lookup": {
      "post": {
        "description": "Verdicts for up to 100 SHA-256 digests. Submitted hashes are neither logged nor stored.\n\n`malicious` means the hash is an active signature. `unknown` means it is not; it does not\nmean the file is safe.",
        "operationId": "reputation_lookup_v1_reputation_lookup_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LookupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LookupResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "413": {
            "description": "Request body too large."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "ApiKey": []
          },
          {
            "Bearer": []
          }
        ],
        "summary": "Reputation Lookup",
        "tags": [
          "reputation"
        ]
      }
    },
    "/v1/rules": {
      "get": {
        "description": "The latest signed YARA ruleset.\n\nSend the ETag of the ruleset in use as `If-None-Match` (`\"rules-<version>\"`): an unchanged\nruleset costs a 304 with no body. Clients must verify `signature` with a trusted key and\ncheck that `rules` hashes to `sha256` before using the rules, and must ignore versions that\nare not newer than the ones they have. See docs/sync-protocol.md.",
        "operationId": "latest_rules_v1_rules_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RulesetResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "304": {
            "description": "The client already has this version (`If-None-Match`)."
          },
          "404": {
            "description": "No ruleset has been published yet."
          }
        },
        "security": [
          {
            "ApiKey": []
          },
          {
            "Bearer": []
          }
        ],
        "summary": "Latest Rules",
        "tags": [
          "rules"
        ]
      }
    },
    "/v1/signatures/delta": {
      "get": {
        "description": "Net additions and removals since `since`, paginated, gzip-compressed.\n\nEvery hash appears at most once across all pages with its latest state, so a client that\nskipped any number of versions applies one delta and ends at `until`. Store `until` as the\nnew local version only after the last page (`next_cursor` null) has been applied.",
        "operationId": "signatures_delta_v1_signatures_delta_get",
        "parameters": [
          {
            "description": "The client's current version.",
            "in": "query",
            "name": "since",
            "required": true,
            "schema": {
              "description": "The client's current version.",
              "minimum": 0,
              "title": "Since",
              "type": "integer"
            }
          },
          {
            "description": "Page size; defaults to 5,000 and is capped at 20,000.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Page size; defaults to 5,000 and is capped at 20,000.",
              "title": "Limit"
            }
          },
          {
            "description": "`next_cursor` from the previous page.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 512,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "`next_cursor` from the previous page.",
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeltaResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "Invalid cursor, or cursor issued for a different `since`."
          },
          "409": {
            "description": "`since` is newer than the server's latest version; full sync."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "ApiKey": []
          },
          {
            "Bearer": []
          }
        ],
        "summary": "Signatures Delta",
        "tags": [
          "signatures"
        ]
      }
    },
    "/v1/signatures/full": {
      "get": {
        "description": "Full snapshot of active signatures, streamed from one consistent database snapshot.",
        "operationId": "signatures_full_v1_signatures_full_get",
        "responses": {
          "200": {
            "content": {
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "NDJSON stream: a header line, one line per active signature ordered by hash, and an end line. A stream without the end line is truncated; discard it."
          }
        },
        "security": [
          {
            "ApiKey": []
          },
          {
            "Bearer": []
          }
        ],
        "summary": "Signatures Full",
        "tags": [
          "signatures"
        ]
      }
    },
    "/v1/signatures/version": {
      "get": {
        "description": "Latest published signature version. Clients poll this before syncing.",
        "operationId": "signatures_version_v1_signatures_version_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "ApiKey": []
          },
          {
            "Bearer": []
          }
        ],
        "summary": "Signatures Version",
        "tags": [
          "signatures"
        ]
      }
    }
  }
}
