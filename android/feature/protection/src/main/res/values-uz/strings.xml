    <string name="troubleshooting_title">Muammolarni hal qilish</string>
    <string name="troubleshooting_back">Orqaga</string>
    <string name="troubleshooting_intro">Ba’zi sozlamalar va telefon ishlab chiqaruvchilari fon ilovalarini to‘xtatadi. Bu sahifa ularni tekshiradi.</string>
    <string name="troubleshooting_all_good">Hammasi joyida. Himoya ishlashda davom etadi.</string>
    <string name="issue_protection_off_title">Real vaqt himoyasi o‘chiq</string>
    <string name="issue_protection_off_body">Yangi ilova va yuklanmalar tekshirilmaydi.</string>
    <string name="issue_not_running_title">Himoya ishlamayapti</string>
    <string name="issue_not_running_body">Tizim uni to‘xtatgan. Qayta ishga tushiring va quyidagilarni tekshiring.</string>
    <string name="issue_notifications_title">Bildirishnomalar bloklangan</string>
    <string name="issue_notifications_body">Ogohlantirishlar sizga yetib bormaydi.</string>
    <string name="issue_threat_channel_title">Tahdid ogohlantirishlari o‘chiq</string>
    <string name="issue_threat_channel_body">“Tahdid ogohlantirishlari” toifasini yoqing.</string>
    <string name="issue_background_title">Fonda ishlash cheklangan</string>
    <string name="issue_background_body">Ilova haqida &gt; Batareya bo‘limida “Cheklanmagan” yoki “Optimallashtirilgan”ni tanlang.</string>
    <string name="issue_battery_title">Batareya optimallashtirish yoqiq</string>
    <string name="issue_battery_body">BlackShieldni tanlang va “Optimallashtirmaslik”ni belgilang. Himoya juda kam quvvat sarflaydi.</string>
    <string name="issue_bucket_title">Android BlackShieldni kam ishlatiladi deb hisoblaydi</string>
    <string name="issue_bucket_body">Ilovani vaqti-vaqti bilan oching yoki Ilova haqida bo‘limida fon cheklovlarini olib tashlang.</string>
    <string name="issue_downloads_title">Yuklanmalarni tekshirib bo‘lmaydi</string>
    <string name="issue_downloads_body">BlackShield yuklanmalarni ko‘rishi uchun “Barcha fayllarga kirish”ga ruxsat bering.</string>
    <string name="issue_oem_title">Telefoningiz fon ilovalarini to‘xtatishi mumkin</string>
    <string name="oem_xiaomi">Xiaomi, Redmi, POCO: Avtoishga tushirishni yoqing va Quvvat tejashni “Cheklovlarsiz” qiling.</string>
    <string name="oem_huawei">Huawei, Honor: Ilovalarni ishga tushirish bo‘limida BlackShieldni “Qo‘lda boshqarish”ga o‘tkazing va barcha bandlarni yoqing.</string>
    <string name="oem_samsung">Samsung: BlackShieldni “Uxlayotgan ilovalar”dan olib, “Hech qachon uxlamaydigan ilovalar”ga qo‘shing.</string>
    <string name="oem_oneplus">OnePlus: avtoishga tushirishga ruxsat bering va batareyani “Optimallashtirmaslik”ga o‘rnating.</string>
    <string name="oem_oppo">OPPO, realme: avtoishga tushirish va fonda ishlashga ruxsat bering.</string>
    <string name="oem_vivo">vivo, iQOO: fonda ishga tushish va fonda yuqori quvvat sarfiga ruxsat bering.</string>
