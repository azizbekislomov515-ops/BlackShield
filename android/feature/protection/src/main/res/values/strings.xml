    <!-- Troubleshooting -->
    <string name="troubleshooting_title">Troubleshooting</string>
    <string name="troubleshooting_back">Back</string>
    <string name="troubleshooting_intro">Some settings and phone makers stop background apps. This page checks for them.</string>
    <string name="troubleshooting_all_good">All good. Protection can keep running.</string>
    <string name="issue_protection_off_title">Real-time protection is off</string>
    <string name="issue_protection_off_body">New apps and downloads aren\'t checked.</string>
    <string name="issue_not_running_title">Protection is not running</string>
    <string name="issue_not_running_body">The system stopped it. Restart it, then check below.</string>
    <string name="issue_notifications_title">Notifications are blocked</string>
    <string name="issue_notifications_body">Warnings can\'t reach you.</string>
    <string name="issue_threat_channel_title">Threat warnings are off</string>
    <string name="issue_threat_channel_body">Turn on the “Threat warnings” category.</string>
    <string name="issue_background_title">Background use is restricted</string>
    <string name="issue_background_body">In App info &gt; Battery, choose “Unrestricted” or “Optimized”.</string>
    <string name="issue_battery_title">Battery optimization is on</string>
    <string name="issue_battery_body">Select BlackShield and choose “Don\'t optimize”. Protection uses very little battery.</string>
    <string name="issue_bucket_title">Android thinks BlackShield is rarely used</string>
    <string name="issue_bucket_body">Open the app now and then, or lift background limits in App info.</string>
    <string name="issue_downloads_title">Downloads can\'t be checked</string>
    <string name="issue_downloads_body">Allow “All files access” so BlackShield can see Download.</string>
    <string name="issue_oem_title">Your phone may stop background apps</string>
    <string name="oem_xiaomi">Xiaomi, Redmi, POCO: turn on Autostart and set Battery saver to “No restrictions”.</string>
    <string name="oem_huawei">Huawei, Honor: in App launch, set BlackShield to “Manage manually” with all options on.</string>
    <string name="oem_samsung">Samsung: remove BlackShield from “Sleeping apps” and add it to “Never sleeping apps”.</string>
    <string name="oem_oneplus">OnePlus: allow auto-launch and set battery to “Don\'t optimize”.</string>
    <string name="oem_oppo">OPPO, realme: allow auto-launch and background activity.</string>
    <string name="oem_vivo">vivo, iQOO: allow background start and high background power use.</string>
    <string name="fix_enable">Turn on</string>
    <string name="fix_restart">Restart protection</string>
    <string name="fix_notifications">Notification settings</string>
    <string name="fix_battery">Battery optimization</string>
    <string name="fix_app_settings">App info</string>
    <string name="fix_all_files">Allow all files access</string>
    <string name="fix_oem">Open phone settings</string>
</resources>
