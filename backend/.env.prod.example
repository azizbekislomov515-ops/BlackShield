# Production settings for docker-compose.prod.yml. Copy to .env (never commit it) and fill in every value.
# Secrets belong in a secrets manager; this file is read only by docker compose on the host.

BLACKSHIELD_VERSION=1.0.0

# PostgreSQL. Use a long random password (e.g. openssl rand -base64 32).
POSTGRES_USER=blackshield
POSTGRES_PASSWORD=
POSTGRES_DB=blackshield
BACKUP_KEEP_DAYS=14

# Directory on the host with fullchain.pem and privkey.pem for the API host name.
TLS_CERT_DIR=/etc/letsencrypt/live/api.example.com

# API
LOG_LEVEL=INFO
# key_id:sha256 entries from `blackshield-signatures generate-api-key --id android-v1` (only hashes here).
API_KEYS=
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_BURST=120
AUTH_FAILURE_LIMIT_PER_MINUTE=10
MAX_REQUEST_BODY_BYTES=16384
CORS_ALLOWED_ORIGINS=
METRICS_ENABLED=true
METRICS_TOKEN=

# Feed ingestion (workers profile)
MALWAREBAZAAR_API_KEY=
PHISHTANK_APP_KEY=
