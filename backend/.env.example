# Copy to .env and adjust. docker compose reads this file for both services.

# API
APP_NAME="BlackShield API"
ENVIRONMENT=development
DEBUG=false
API_PORT=8000

# PostgreSQL (container)
POSTGRES_USER=blackshield
POSTGRES_PASSWORD=change-me
POSTGRES_DB=blackshield
POSTGRES_PORT=5432

# SQLAlchemy URL used by the API and Alembic.
# Inside docker compose the host is the "db" service; for a local run use localhost.
DATABASE_URL=postgresql+psycopg://blackshield:change-me@localhost:5432/blackshield

# Logging: JSON lines (true) or plain text (false).
LOG_LEVEL=INFO
LOG_JSON=true
# Set to false to hide /docs, /redoc and /openapi.json in production.
DOCS_ENABLED=true

# --- /v1 API security (see docs/sync-protocol.md) ---
# Comma-separated key_id:sha256 entries. Create one with:
#   blackshield-signatures generate-api-key --id android-v1
# Empty = every /v1 request is rejected.
API_KEYS=
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=30
AUTH_FAILURE_LIMIT_PER_MINUTE=10
MAX_REQUEST_BODY_BYTES=16384
# Browser origins allowed by CORS (comma-separated). The Android app needs none.
# Explicit origins only (https://admin.example.com); "*" and paths are rejected at startup.
CORS_ALLOWED_ORIGINS=

# --- Signature ingestion ---
# abuse.ch Auth-Key from https://auth.abuse.ch/
MALWAREBAZAAR_API_KEY=
MALWAREBAZAAR_FILE_TYPES=apk
MALWAREBAZAAR_TAGS=
MALWAREBAZAAR_LIMIT=1000
MALWAREBAZAAR_MIN_INTERVAL_SECONDS=2
MALWAREBAZAAR_MAX_RETRIES=5
INGEST_INTERVAL_SECONDS=3600

# --- YARA rules publishing (blackshield-signatures rules-publish; not used by the API server) ---
# Path to the EC P-256 signing key (PEM) from `blackshield-signatures rules-keygen --id k1`.
# Keep the key offline; the app trusts its public half (Gradle property blackshield.yaraRulesPublicKeys).
RULES_SIGNING_KEY_FILE=
RULES_SIGNING_KEY_ID=k1

# --- Web Shield domain feeds (blackshield-signatures domains-ingest / domains-schedule) ---
URLHAUS_HOSTFILE_URL=https://urlhaus.abuse.ch/downloads/hostfile/
# Free PhishTank application key; empty skips PhishTank. Check PhishTank's terms first.
PHISHTANK_APP_KEY=
DOMAINS_INGEST_INTERVAL_SECONDS=3600
