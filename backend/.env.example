# Copy to .env and adjust. docker compose reads this file for both services.

# API
APP_NAME="BlackShield API"
ENVIRONMENT=development
DEBUG=false
API_PORT=8000

# PostgreSQL (container)
POSTGRES_USER=blackshield
POSTGRES_PASSWORD=change-me
POSTGRES_DB=blackshield
POSTGRES_PORT=5432

# SQLAlchemy URL used by the API and Alembic.
# Inside docker compose the host is the "db" service; for a local run use localhost.
DATABASE_URL=postgresql+psycopg://blackshield:change-me@localhost:5432/blackshield
